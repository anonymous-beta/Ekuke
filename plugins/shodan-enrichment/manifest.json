{
    "id": "shodan-enrichment",
    "name": "Shodan Enrichment",
    "version": "1.0.0",
    "author": "EKUKE",
    "description": "Enrich IPv4/Domain via Shodan API. BYO API key. Request goes direct to Shodan, never through us.",
    "input_types": ["IPv4", "Domain"],
    "output_types": ["IPv4", "Port", "Certificate", "Organization", "Domain"],
    "command": "python3",
    "args": ["main.py"],
    "config_fields": [
        {"name": "api_key", "field_type": "string", "default": "", "required": true, "description": "Shodan API key"},
        {"name": "proxy", "field_type": "string", "default": "", "required": false, "description": "HTTP proxy URL"}
    ]
}
